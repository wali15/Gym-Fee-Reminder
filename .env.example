# ─────────────────────────────────────────────────────────────────────────────
# Gym Fee Reminder — environment variables
#
# ZERO-TOUCH SETUP: the only thing you MUST provide is your Turso database URL
# and auth token below. Everything else (schema creation, first admin, session
# secret, email/WhatsApp config) is handled automatically — create your admin
# account on first visit, then configure email/WhatsApp in the app at /settings.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Database (Turso / libSQL)
# Create a database at https://turso.tech, then paste its URL + token here.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# ─────────────────────────────────────────────────────────────────────────────
# Everything below is OPTIONAL.
# ─────────────────────────────────────────────────────────────────────────────

# Optional — Session secret.
# If omitted, the app generates one automatically and stores it in the database
# (stable across restarts). Set this only if you want to control it yourself.
# Must be at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=

# Optional — Pre-seed the first admin (instead of using the /login setup screen).
# If both are set AND no users exist yet, this admin is created automatically.
# Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# NOTE: escape every \$ in the hash as \\$ (Next.js runs dotenv-expand, which would
# otherwise treat \$2a/\$12/... as variables and blank out the hash).
# ADMIN_EMAIL=admin@yourgym.com
# ADMIN_PASSWORD_HASH=\\$2a\\$12\\$your-escaped-hash

# Optional — Notification providers.
# You can configure these in the app at /settings instead. Values set here act
# only as fallbacks when the corresponding setting is empty.
# RESEND_API_KEY=re_your-api-key
# WHATSAPP_TOKEN=your-whatsapp-access-token
# WHATSAPP_PHONE_ID=your-phone-number-id

# Optional — Google SSO (for authentication)
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional — External SMTP Relay (for email sending)
# Configure these to use an external SMTP server instead of Resend
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
# Set to "true" for SSL/TLS on port 465, "false" for STARTTLS on ports 587/25
SMTP_SECURE=false

# Optional — Payment webhooks (kept in env for security).
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# RAZORPAY_KEY_ID=rzp_test_your-key
# RAZORPAY_KEY_SECRET=your-secret
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Optional — Public app URL, used to build the "Pay now" link in emails.
# NEXT_PUBLIC_APP_URL=https://your-site.netlify.app